rules_version = '2';
// Publicado via GitHub Actions
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isUserAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['isAdmin'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Professor: gerência (ver usuários, editar conteúdo) sem ser admin do sistema.
    // Substitui o antigo "admin comum" — só o super admin (email fixo) concede/remove
    // isAdmin/isProfessor/bloqueado (ver regra de update abaixo).
    function isProfessor() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['isProfessor'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProfessor == true;
    }

    function canManage() {
      return isUserAdmin() || isProfessor();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'nome', 'avatar', 'email'])
        && data.id is string
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 50
        && (!data.keys().hasAny(['turma']) || data.turma is string)
        && data.avatar is string && data.avatar.size() > 0 && data.avatar.size() <= 1048576
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && (!data.keys().hasAny(['criadoEm']) || data.criadoEm is string)
        && (!data.keys().hasAny(['isAdmin']) || data.isAdmin is bool)
        && (!data.keys().hasAny(['isProfessor']) || data.isProfessor is bool)
        && (!data.keys().hasAny(['isGuest']) || data.isGuest is bool)
        && (!data.keys().hasAny(['bloqueado']) || data.bloqueado is bool)
        && (!data.keys().hasAny(['telefone']) || (data.telefone is string && data.telefone.size() <= 20))
        && (!data.keys().hasAny(['whatsappOptIn']) || data.whatsappOptIn is bool)
        && (!data.keys().hasAny(['manualNotification']) || data.manualNotification is map)
        && (!data.keys().hasAny(['track']) || data.track in ['teen', 'juvenil', 'youngAdult', 'adult'])
        && (!data.keys().hasAny(['locationId']) || (data.locationId is string && data.locationId.size() > 0 && data.locationId.size() <= 200))
        // turmaId (Fase 1): opcional para não invalidar NENHUM usuário atual —
        // todos estão sem o campo até o backfill da Fase 2. A partir dela, é a
        // turma que passa a definir local e trilha; aqui só se aceita o campo.
        && (!data.keys().hasAny(['turmaId']) || (data.turmaId is string && data.turmaId.size() > 0 && data.turmaId.size() <= 200))
        && (!data.keys().hasAny(['inviteCode']) || (data.inviteCode is string && data.inviteCode.size() <= 40));
    }

    // Uma vez definidos pelo próprio usuário no cadastro, locationId e turmaId
    // só podem ser trocados por admin (ver bloco de update abaixo) — impede que
    // o usuário se mova de local ou de turma sozinho depois de escolher. A
    // trilha segue a mesma trava para alunos comuns, mas admin/professor podem
    // alternar a própria trilha livremente (uso próprio: testar/acompanhar
    // outras trilhas sem precisar de outro admin para liberar).
    //
    // turmaId NÃO tem a saída do canManage(): trocar alguém de turma é ato
    // administrativo mesmo para quem gerencia, e passa pelo branch de admin do
    // update (que exige isUserAdmin()), nunca por este.
    function ownerLocationTrackUnchanged() {
      return (!existing().keys().hasAny(['locationId']) || incoming().locationId == existing().locationId)
        && (!existing().keys().hasAny(['turmaId']) || incoming().turmaId == existing().turmaId)
        && (canManage() || !existing().keys().hasAny(['track']) || incoming().track == existing().track);
    }

    // Convite por código (ferramenta pronta, mas não obrigatória agora — ver
    // baixo): valida um inviteCode ativo cujo local+trilha batem com o que
    // está sendo gravado. Continua funcionando de ponta a ponta (professor/
    // admin geram, aluno pode resgatar) mesmo com a exigência desligada.
    function inviteCodeMatchesIncoming() {
      return incoming().keys().hasAny(['inviteCode'])
        && incoming().inviteCode is string
        && exists(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode))
        && get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.active == true
        && get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.locationId == incoming().locationId
        && get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.track == incoming().track;
    }

    // true quando o dono está DEFININDO um locationId que ainda não existia
    function ownerSettingNewLocation() {
      return !existing().keys().hasAny(['locationId']) && incoming().keys().hasAny(['locationId']);
    }

    // Desativado em 2026-07-20: usuários antigos (sem locationId, cadastrados
    // antes da Etapa 1) ficavam travados no cadastro — só sobrava o campo de
    // código, sem forma de prosseguir. Agora o dono pode se matricular
    // livremente em QUALQUER local que exista de verdade (exists() abaixo —
    // ainda bloqueia locationId inventado/de outro projeto), sem precisar de
    // código; o código continua sendo um caminho válido (inviteCodeMatchesIncoming).
    // Para reativar "matrícula só por convite": troque o
    // `|| exists(.../studyLocations/$(incoming().locationId))` por nada (ou
    // seja, remova esse último `||`) nas duas funções abaixo, e troque
    // REQUIRE_INVITE_CODE_FOR_STUDENTS para `true` em components.tsx.
    function ownerLocationAllowedOnUpdate() {
      return !ownerSettingNewLocation()
        || canManage()
        || inviteCodeMatchesIncoming()
        || exists(/databases/$(database)/documents/studyLocations/$(incoming().locationId));
    }
    function ownerLocationAllowedOnCreate() {
      return !incoming().keys().hasAny(['locationId'])
        || canManage()
        || inviteCodeMatchesIncoming()
        || exists(/databases/$(database)/documents/studyLocations/$(incoming().locationId));
    }

    // Mesma proteção do locationId, aplicada à turma: o dono só se matricula
    // numa turma que EXISTE de verdade. Sem isto, bastaria gravar um turmaId
    // qualquer no próprio perfil para que o progresso (que a regra obriga a
    // bater com ownTurmaId()) passasse a carimbar aquela turma — e o aluno
    // apareceria no ranking de uma turma de outra igreja.
    function ownerSettingNewTurma() {
      return !existing().keys().hasAny(['turmaId']) && incoming().keys().hasAny(['turmaId']);
    }
    function ownerTurmaAllowedOnUpdate() {
      return !ownerSettingNewTurma()
        || isUserAdmin()
        || exists(/databases/$(database)/documents/turmas/$(incoming().turmaId));
    }
    function ownerTurmaAllowedOnCreate() {
      return !incoming().keys().hasAny(['turmaId'])
        || isUserAdmin()
        || exists(/databases/$(database)/documents/turmas/$(incoming().turmaId));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) || canManage();

      allow create: if isOwner(userId)
        && incoming().id == userId
        && incoming().keys().hasOnly(['id', 'nome', 'turma', 'avatar', 'email', 'criadoEm', 'isAdmin', 'isProfessor', 'isGuest', 'bloqueado', 'telefone', 'whatsappOptIn', 'manualNotification', 'track', 'locationId', 'turmaId', 'inviteCode'])
        && (!incoming().keys().hasAny(['isAdmin']) || incoming().email.lower() == 'robsonbraz67@gmail.com')
        && ownerLocationAllowedOnCreate()
        && ownerTurmaAllowedOnCreate()
        && isValidUser(incoming());

      allow update: if (isOwner(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'turma', 'avatar', 'isAdmin', 'criadoEm', 'telefone', 'whatsappOptIn', 'manualNotification', 'track', 'locationId', 'turmaId', 'inviteCode'])
        && incoming().id == existing().id
        && incoming().email == existing().email
        && (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin']) || incoming().email.lower() == 'robsonbraz67@gmail.com')
        && ownerLocationTrackUnchanged()
        && ownerLocationAllowedOnUpdate()
        && ownerTurmaAllowedOnUpdate()
        && isValidUser(incoming())) || (
        isUserAdmin()
        && incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'isProfessor', 'isGuest', 'bloqueado', 'locationId', 'turmaId', 'track'])
        && isValidUser(incoming())) || (
        // RESGATE DE CONVITE DE PROFESSOR (Fase 3) — a única auto-promoção do
        // sistema, e por isso a mais estreita: só o próprio dono, só estes três
        // campos, e só depois de ter QUEIMADO um convite que aponta para a
        // turma que ele está gravando (ver teacherInviteBurnedByMe). Sem isso,
        // bastaria um update no próprio perfil para virar professor.
        //
        // isAdmin fica de fora de propósito: convite de professor nunca vira
        // admin, nem por acidente de digitação em algum lugar do cliente.
        isOwner(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['isProfessor', 'turmaId', 'inviteCode'])
        && incoming().isProfessor == true
        && incoming().id == existing().id
        && incoming().email == existing().email
        && teacherInviteBurnedByMe()
        && isValidUser(incoming()));

      allow delete: if isUserAdmin();
    }

    function isValidStudyLocation(data) {
      return data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.createdBy is string;
    }

    match /studyLocations/{locationId} {
      // Todo usuário autenticado precisa listar locais para escolher no cadastro
      allow get, list: if isAuthenticated();

      // Locais são dado administrativo: só admin/professor cadastra (evita que
      // aluno comum polua o dropdown de cadastro com locais lixo/spam). Aluno
      // sem local disponível pede ao professor/admin para cadastrar.
      allow create: if canManage()
        && isValidStudyLocation(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isValidStudyLocation(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && ((isAuthenticated() && existing().createdBy == request.auth.uid) || isUserAdmin());

      allow delete: if isUserAdmin();
    }

    // ===== Turmas (Fase 1) =====
    // A turma é o escopo primário da expansão: ela pertence a uma igreja
    // (locationId) e define a trilha; o aluno herda as duas ao se matricular.
    // Nada no app escreve aqui ainda — o painel chega na Fase 2. A regra sobe
    // antes porque hasOnly() recusa o documento INTEIRO ao ver chave que não
    // conhece, então o campo precisa ser aceito antes do código que o grava.
    function isValidTurma(data) {
      return data.keys().hasOnly(['locationId', 'track', 'nome', 'professores', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.locationId is string && data.locationId.size() > 0 && data.locationId.size() <= 200
        && data.track in ['teen', 'juvenil', 'youngAdult', 'adult']
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 80
        // Lista de uids: permite mais de um professor por turma sem doc extra.
        && data.professores is list && data.professores.size() <= 20
        && data.active is bool
        && data.createdBy is string;
    }

    match /turmas/{turmaId} {
      // Todo autenticado lê: o aluno precisa ver a turma para se matricular, e
      // o nome dela aparece no ranking. O conteúdo é administrativo, não pessoal.
      allow get, list: if isAuthenticated();

      allow create: if isUserAdmin() && isValidTurma(incoming());

      allow update: if (isUserAdmin() && isValidTurma(incoming()))
        // O professor da turma pode renomear a PRÓPRIA turma — e só isso.
        // Igreja e trilha ficam de fora porque mudá-las moveria os alunos de
        // escopo sem ninguém pedir; a lista de professores fica de fora para
        // que um professor não consiga tirar outro.
        || (isProfessor()
          && (request.auth.uid in existing().professores)
          && incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'updatedAt'])
          && isValidTurma(incoming()))
        // Quem acabou de resgatar um convite entra na lista da própria turma.
        // Só pode ACRESCENTAR a si mesmo: hasAll() garante que ninguém sai, e
        // size() + 1 garante que só um nome entra — o dele.
        || (isProfessor()
          && ownTurmaId() == turmaId
          && incoming().diff(existing()).affectedKeys().hasOnly(['professores', 'updatedAt'])
          && incoming().professores.hasAll(existing().professores)
          && incoming().professores.size() == existing().professores.size() + 1
          && (request.auth.uid in incoming().professores)
          && isValidTurma(incoming()));

      // Turma se ARQUIVA (active: false), nunca se exclui: os documentos de
      // progresso carregam turmaId, e apagar a turma deixaria esse histórico
      // órfão — o ranking da campanha ficaria com buracos sem ninguém entender
      // por quê. A decisão fica travada aqui, não só na documentação.
      allow delete: if false;
    }

    function isValidTeacherAssignment(data) {
      return data.keys().hasOnly(['locationId', 'assignedBy', 'assignedAt'])
        && data.locationId is string && data.locationId.size() > 0
        && data.assignedBy is string
        && data.assignedAt == request.time;
    }

    // Doc id == uid do professor. Só admin define/altera; o próprio professor
    // (e o admin) podem ler para saber a que local está vinculado.
    match /teacherAssignments/{teacherId} {
      allow get: if isOwner(teacherId) || isUserAdmin();
      allow list: if isUserAdmin();
      allow create, update: if isUserAdmin()
        && isValidTeacherAssignment(incoming())
        && incoming().assignedBy == request.auth.uid; // audit trail não forjável
      allow delete: if isUserAdmin();
    }

    function isValidInviteCode(data) {
      return data.keys().hasOnly(['code', 'locationId', 'turmaId', 'track', 'active', 'createdBy', 'createdAt'])
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 40
        && data.locationId is string && data.locationId.size() > 0 && data.locationId.size() <= 200
        // Opcional: os códigos já emitidos não têm turma, e continuam válidos.
        && (!data.keys().hasAny(['turmaId']) || (data.turmaId is string && data.turmaId.size() > 0 && data.turmaId.size() <= 200))
        && data.track in ['teen', 'juvenil', 'youngAdult', 'adult']
        && data.active is bool
        && data.createdBy is string;
    }

    // Local ao qual o professor autenticado está atribuído (teacherAssignments/{uid}).
    // Usada só depois de checar exists(), para não estourar em quem não é professor.
    function myTeacherLocation() {
      return get(/databases/$(database)/documents/teacherAssignments/$(request.auth.uid)).data.locationId;
    }

    // Professor só pode emitir convite para o local exatamente atribuído a ele.
    // É a trava central da Etapa 3: sem isto, dava pra emitir código de qualquer
    // local via console/API mesmo com a UI restringindo.
    function professorCanIssueFor(locationId) {
      return isProfessor()
        && exists(/databases/$(database)/documents/teacherAssignments/$(request.auth.uid))
        && myTeacherLocation() == locationId;
    }

    // Caminho novo da Fase 3: o professor emite convite para a PRÓPRIA turma,
    // sem depender de teacherAssignments. O antigo continua valendo — quem já
    // tinha local atribuído não perde nada.
    function professorOwnsTurma(turmaId) {
      return isProfessor() && ownTurmaId() == turmaId;
    }

    match /inviteCodes/{codeId} {
      // Resgate: precisa saber o código exato (== doc id). list só p/ quem gerencia,
      // pra ninguém enumerar todos os códigos do sistema.
      allow get: if isAuthenticated();
      allow list: if canManage();

      // Admin cria para qualquer local+trilha; professor só para o local atribuído.
      allow create: if isValidInviteCode(incoming())
        && codeId == incoming().code
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().active == true
        && (isUserAdmin()
          || professorCanIssueFor(incoming().locationId)
          || (incoming().keys().hasAny(['turmaId']) && professorOwnsTurma(incoming().turmaId)));

      // Revogar/reativar: admin qualquer um, professor só os que ele criou.
      // Só o campo 'active' pode mudar — local/trilha/código são imutáveis.
      allow update: if isValidInviteCode(incoming())
        && incoming().code == existing().code
        && incoming().locationId == existing().locationId
        && incoming().track == existing().track
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['active'])
        && (isUserAdmin() || (isProfessor() && existing().createdBy == request.auth.uid));

      allow delete: if isUserAdmin() || (isProfessor() && existing().createdBy == request.auth.uid);
    }

    // ===== Convite de professor (Fase 1) =====
    // Diferente de inviteCodes (que matricula ALUNO numa trilha): resgatar este
    // aqui torna a pessoa professora de UMA turma. Como concede poder, é mais
    // fechado que o convite de aluno em dois pontos: só admin emite, e nem
    // professor pode listar (list é exclusivo de admin).
    //
    // O RESGATE — marcar usedBy/usedAt e desativar — é a Fase 3, e sobe junto
    // com os testes do painel do professor. Aqui só existe a emissão.
    function isValidTeacherInvite(data) {
      return data.keys().hasOnly(['code', 'locationId', 'turmaId', 'active', 'createdBy', 'createdAt', 'expiresAt', 'usedBy', 'usedAt'])
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 40
        && data.locationId is string && data.locationId.size() > 0 && data.locationId.size() <= 200
        && data.turmaId is string && data.turmaId.size() > 0 && data.turmaId.size() <= 200
        && data.active is bool
        && data.createdBy is string
        // Validade obrigatória: convite que dá poder não fica valendo para
        // sempre num grupo de WhatsApp (mesma escolha de pairInvites).
        && data.expiresAt is timestamp
        && (!data.keys().hasAny(['usedBy']) || (data.usedBy is string && data.usedBy.size() <= 200));
    }

    match /teacherInvites/{codeId} {
      // Resgate: precisa saber o código exato (== doc id), como em inviteCodes.
      allow get: if isAuthenticated();
      // list só admin — nem professor enumera os convites de professor.
      allow list: if isUserAdmin();

      allow create: if isUserAdmin()
        && codeId == incoming().code
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().active == true
        && !incoming().keys().hasAny(['usedBy', 'usedAt'])
        && exists(/databases/$(database)/documents/turmas/$(incoming().turmaId))
        && isValidTeacherInvite(incoming());

      // Admin revoga/reativa: só o campo 'active' muda.
      allow update: if (isUserAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['active'])
        && isValidTeacherInvite(incoming()))
        // RESGATE (Fase 3). Queimar o convite é o PRIMEIRO passo do resgate, não
        // o último: esta escrita é um compare-and-set num único documento, então
        // se duas pessoas abrirem o mesmo link ao mesmo tempo, exatamente uma
        // ganha. Só depois disso o perfil pode virar professor — e a regra de
        // users confere `usedBy == quem está escrevendo`. Invertida (perfil
        // primeiro, convite depois), a janela entre as duas escritas promoveria
        // as duas pessoas.
        //
        // Se a segunda metade falhar, o convite fica queimado e ninguém foi
        // promovido: erra para o lado de conceder poder de menos.
        || (isAuthenticated()
          && existing().active == true
          && !existing().keys().hasAny(['usedBy'])
          && existing().expiresAt > request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'usedBy', 'usedAt'])
          && incoming().active == false
          && incoming().usedBy == request.auth.uid
          && incoming().usedAt == request.time
          && isValidTeacherInvite(incoming()));

      allow delete: if isUserAdmin();
    }

    // O convite que ESTA pessoa acabou de queimar aponta para a turma que ela
    // está gravando no próprio perfil? É o que autoriza alguém a se marcar
    // professor — a única auto-promoção que existe no sistema.
    function teacherInviteBurnedByMe() {
      return incoming().keys().hasAny(['inviteCode'])
        && incoming().inviteCode is string
        && exists(/databases/$(database)/documents/teacherInvites/$(incoming().inviteCode))
        && get(/databases/$(database)/documents/teacherInvites/$(incoming().inviteCode)).data.get('usedBy', '') == request.auth.uid
        && get(/databases/$(database)/documents/teacherInvites/$(incoming().inviteCode)).data.turmaId == incoming().turmaId;
    }

    // ===== Estudo em Dupla (Etapa 4) =====
    // Local+trilha do usuário autenticado batem com os passados? (escopo social)
    function myLocationTrackMatches(loc, trk) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.locationId == loc
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.track == trk;
    }

    function isValidPairInvite(data) {
      return data.keys().hasOnly(['createdBy', 'createdByName', 'createdByAvatar', 'locationId', 'track', 'type', 'status', 'createdAt', 'expiresAt'])
        && data.createdBy is string
        && data.createdByName is string && data.createdByName.size() <= 50
        && data.createdByAvatar is string && data.createdByAvatar.size() <= 1048576
        && data.locationId is string && data.locationId.size() > 0
        && data.track in ['teen', 'juvenil', 'youngAdult', 'adult']
        && data.type in ['family', 'couple', 'friend']
        && data.status in ['pending', 'accepted', 'expired']
        && data.expiresAt is timestamp;
    }

    match /pairInvites/{inviteId} {
      // Resgate por link: precisa saber o inviteId (doc id). list só dos próprios.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Só convida para o próprio local+trilha (validado no servidor).
      allow create: if isAuthenticated()
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && isValidPairInvite(incoming())
        && myLocationTrackMatches(incoming().locationId, incoming().track);

      allow update: if isAuthenticated() && (
          // criador cancela o convite
          (existing().createdBy == request.auth.uid
           && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
           && incoming().status == 'expired')
          ||
          // quem aceita marca como aceito: precisa ser de outro usuário, ainda
          // válido, e do mesmo local+trilha
          (existing().status == 'pending'
           && existing().createdBy != request.auth.uid
           && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
           && incoming().status == 'accepted'
           && existing().expiresAt > request.time
           && myLocationTrackMatches(existing().locationId, existing().track))
        );

      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    function isValidPair(data) {
      return data.keys().hasOnly(['inviteId', 'members', 'userA', 'userB', 'userAName', 'userAAvatar', 'userBName', 'userBAvatar', 'locationId', 'track', 'type', 'active', 'createdAt', 'sharesA', 'sharesB'])
        && data.members is list && data.members.size() == 2
        && data.userA is string && data.userB is string
        && data.members[0] == data.userA && data.members[1] == data.userB
        && data.userA != data.userB
        && data.locationId is string && data.track in ['teen', 'juvenil', 'youngAdult', 'adult']
        && data.type in ['family', 'couple', 'friend']
        && data.active is bool
        && data.sharesA is map && data.sharesB is map;
    }

    match /pairs/{pairId} {
      // Só os dois membros leem a dupla (e seu conteúdo compartilhado).
      allow get, list: if isAuthenticated() && request.auth.uid in resource.data.members;

      // Quem aceita (userB) cria o doc; pairId == inviteId garante uso único
      // (segunda tentativa colide com doc existente). Valida o convite e o
      // próprio local+trilha do aceitante.
      allow create: if isAuthenticated()
        && pairId == incoming().inviteId
        && incoming().userB == request.auth.uid
        && incoming().active == true
        && incoming().sharesA.size() == 0
        && incoming().sharesB.size() == 0
        && isValidPair(incoming())
        && exists(/databases/$(database)/documents/pairInvites/$(pairId))
        && get(/databases/$(database)/documents/pairInvites/$(pairId)).data.status == 'pending'
        && get(/databases/$(database)/documents/pairInvites/$(pairId)).data.createdBy == incoming().userA
        && get(/databases/$(database)/documents/pairInvites/$(pairId)).data.locationId == incoming().locationId
        && get(/databases/$(database)/documents/pairInvites/$(pairId)).data.track == incoming().track
        && get(/databases/$(database)/documents/pairInvites/$(pairId)).data.expiresAt > request.time
        && myLocationTrackMatches(incoming().locationId, incoming().track);

      // Desfazer a dupla (active=false) ou cada membro editar só o SEU campo de
      // compartilhamento (sharesA para userA, sharesB para userB) — ninguém
      // altera o compartilhamento do outro.
      allow update: if isAuthenticated() && (request.auth.uid in existing().members) && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['active']) && incoming().active == false)
          ||
          // Compartilhar só faz sentido enquanto a dupla está ativa (Etapa 8:
          // impede ex-membro continuar escrevendo numa dupla já desfeita)
          (existing().active == true && request.auth.uid == existing().userA && incoming().diff(existing()).affectedKeys().hasOnly(['sharesA']))
          ||
          (existing().active == true && request.auth.uid == existing().userB && incoming().diff(existing()).affectedKeys().hasOnly(['sharesB']))
        );

      allow delete: if isUserAdmin();
    }

    // ===== Escalação pública das duplas =====
    // Espelho enxuto de pairs/ criado para o ranking de duplas ser calculado AO
    // VIVO no cliente: pairs/ só pode ser lido pelos dois membros (guarda as
    // anotações compartilhadas), então ninguém conseguiria montar a lista de
    // duplas do local sem um processo servidor. Aqui vai só quem forma cada
    // dupla — SEM anotações, SEM destaques e SEM o tipo do vínculo
    // (família/casal/amigo), que continua sendo assunto apenas dos dois.
    // Escrito junto com pairs/ no mesmo batch, então os dois nunca divergem.
    function isValidPairPublic(data) {
      return data.keys().hasOnly(['pairId', 'members', 'aId', 'aNome', 'aAvatar', 'bId', 'bNome', 'bAvatar', 'locationId', 'track', 'active', 'createdAt'])
        && data.members is list && data.members.size() == 2
        && data.aId is string && data.bId is string && data.aId != data.bId
        && data.members.hasOnly([data.aId, data.bId])
        && data.aNome is string && data.bNome is string
        && data.aAvatar is string && data.bAvatar is string
        && data.locationId is string && data.locationId.size() > 0
        && data.track in ['teen', 'juvenil', 'youngAdult', 'adult']
        && data.active is bool;
    }

    match /pairsPublic/{pairId} {
      // Legível por qualquer autenticado (o cliente filtra pelo próprio local).
      // As regras não conseguem impor o filtro de uma query, então o que protege
      // aqui é o conteúdo ser mínimo — nada além do que o ranking já mostra.
      allow get, list: if isAuthenticated();

      // Criado por quem aceita o convite, no mesmo batch de pairs/{pairId}.
      allow create: if isAuthenticated()
        && pairId == incoming().pairId
        && request.auth.uid == incoming().bId
        && incoming().active == true
        && isValidPairPublic(incoming())
        && myLocationTrackMatches(incoming().locationId, incoming().track);

      // Só desfazer — nome e avatar exibidos vêm do progresso (ao vivo), então
      // ninguém precisa (nem pode) reescrever o texto que aparece do parceiro.
      allow update: if isAuthenticated()
        && (request.auth.uid in existing().members)
        && incoming().diff(existing()).affectedKeys().hasOnly(['active'])
        && incoming().active == false;

      allow delete: if isUserAdmin();
    }

    // Local do DONO do progresso, lido do próprio users/{uid}. É o que permite
    // validar o locationId gravado no progresso sem confiar no cliente.
    //
    // BUG HISTÓRICO (publicado 2026-07-25T16:31Z, corrigido aqui): esta função foi apagada por
    // engano numa limpeza de código feita por range de texto (o script de
    // remoção usou "function isValidProgress" como marcador de fim, e essa
    // função ficava bem antes dele — foi engolida junto). A referência
    // ownLocationId() abaixo ficou órfã, mas o `firebase deploy` publicou
    // mesmo assim (a validação da CLI não pega função indefinida na hora do
    // deploy — só quebra em tempo de EXECUÇÃO). Resultado: toda gravação de
    // progresso que incluísse 'locationId' — ou seja, TODO aluno matriculado,
    // em TODO quiz — falhava silenciosamente, com "Progresso não sincronizado"
    // aparecendo pra sempre, mesmo com internet perfeita. Reportado por dois
    // usuários; provavelmente afetava todos. Lição: nunca apagar regras por
    // intervalo de texto sem, depois, rodar exatamente a checagem de função
    // indefinida que encontrou este bug.
    function ownLocationId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('locationId', '');
    }

    // Turma do DONO do progresso (Fase 1). Mesmo papel de ownLocationId(): é o
    // que permite validar o turmaId gravado no progresso sem confiar no
    // cliente. Sem isto, um aluno carimbaria o progresso com a turma de outra
    // igreja e apareceria no ranking dela.
    function ownTurmaId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('turmaId', '');
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'week', 'xp', 'streak', 'nome', 'avatar'])
        && data.userId is string
        && data.week is string && data.week.size() > 0 && data.week.size() <= 20
        && (!data.keys().hasAny(['track']) || data.track in ['teen', 'juvenil', 'youngAdult', 'adult'])
        // locationId no progresso é o que torna o ranking por local calculável
        // ao vivo pelo cliente (progress é público; users/{uid} de terceiro não
        // é). Só pode ser o local real do dono — a regra confere, não o cliente.
        // A exceção do admin existe porque ele corrige o doc de OUTRA pessoa:
        // ownLocationId() ali é o local DELE, e sem esta saída toda correção
        // de aluno matriculado seria recusada.
        && (!data.keys().hasAny(['locationId']) || data.locationId == ownLocationId() || isUserAdmin())
        // turmaId (Fase 1): é o que vai tornar o ranking por turma calculável
        // sem ler users/{uid} de terceiro — e o que o torna barato (ver o custo
        // de leitura na Fase 4 do plano). Mesma trava do locationId, mesma
        // exceção de admin, que escreve no doc dos outros ao corrigir.
        && (!data.keys().hasAny(['turmaId']) || data.turmaId == ownTurmaId() || isUserAdmin())
        && (!data.keys().hasAny(['trimestre']) || data.trimestre is string)
        && data.xp is number
        && data.streak is number
        && data.nome is string
        && data.avatar is string
        && (!data.keys().hasAny(['done']) || data.done is list)
        && (!data.keys().hasAny(['history']) || data.history is map)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time)
        && (!data.keys().hasAny(['isAdmin']) || data.isAdmin is bool)
        && (!data.keys().hasAny(['isGuest']) || data.isGuest is bool)
        && (!data.keys().hasAny(['isProfessor']) || data.isProfessor is bool)
        // Auditoria de pontuação (painel do admin):
        // 'liberados' = dias que o admin soltou para refazer valendo 100%, sem
        // o desconto de quem faz fora da data.
        // 'zeradoEm' = carimbo da última correção. O aparelho do aluno guarda
        // o progresso no localStorage e no boot MESCLA local com servidor
        // pegando o maior XP; sem este carimbo, o próximo login desfaria a
        // correção em silêncio.
        && (!data.keys().hasAny(['liberados']) || data.liberados is list)
        && (!data.keys().hasAny(['zeradoEm']) || data.zeradoEm is number);
    }

    match /progress/{progressId} {
      // Anyone authenticated can read for ranking
      allow get, list: if isAuthenticated();

      // Doc id pode ser a chave legada `${uid}_${week}` (histórico, trilha teen)
      // ou `${uid}_${track}_${week}` (trilhas novas). Como UIDs do Firebase Auth
      // não contêm '_', split('_')[0] isola o dono e cobre os dois formatos.
      allow create: if isAuthenticated()
        && progressId.split('_')[0] == incoming().userId
        && isOwner(incoming().userId)
        && incoming().keys().hasOnly(['userId', 'week', 'track', 'trimestre', 'locationId', 'turmaId', 'xp', 'streak', 'done', 'history', 'nome', 'avatar', 'isAdmin', 'isGuest', 'isProfessor', 'liberados', 'zeradoEm', 'updatedAt'])
        && isValidProgress(incoming())
        && exists(/databases/$(database)/documents/users/$(incoming().userId));

      // 'track' entra em affectedKeys: docs legados não tinham esse campo e o
      // primeiro save depois desta mudança o adiciona — precisa ser permitido.
      //
      // O admin também escreve aqui, e só ele: é a auditoria de pontuação do
      // painel (zerar um dia lançado errado, zerar a semana, liberar um dia
      // para refazer valendo 100%). Sem esta linha a tela existe mas toda
      // correção volta como "permissão negada". Continua valendo tudo o mais:
      // userId e week são imutáveis, e o documento tem de seguir válido.
      allow update: if isAuthenticated()
        && (isOwner(existing().userId) || isUserAdmin())
        && incoming().userId == existing().userId
        && incoming().week == existing().week
        && incoming().diff(existing()).affectedKeys().hasOnly(['track', 'trimestre', 'locationId', 'turmaId', 'xp', 'streak', 'done', 'history', 'nome', 'avatar', 'isAdmin', 'isGuest', 'isProfessor', 'liberados', 'zeradoEm', 'updatedAt'])
        && isValidProgress(incoming());

      allow delete: if false;
    }

    // ===== Anotações privadas (Etapa 8) =====
    // nota/destaque do usuário. Doc id == `${uid}_${week}`. Legível/gravável
    // SÓ pelo dono — diferente de progress, que é público para o ranking.
    // (UIDs do Firebase Auth não contêm '_', então split('_')[0] isola o uid.)
    match /studyNotes/{docId} {
      allow get, list: if isAuthenticated() && docId.split('_')[0] == request.auth.uid;
      allow create, update: if isAuthenticated()
        && incoming().userId == request.auth.uid
        && docId.split('_')[0] == incoming().userId
        && incoming().keys().hasOnly(['userId', 'week', 'track', 'notes', 'updatedAt'])
        && incoming().week is string && incoming().week.size() <= 20
        && (!incoming().keys().hasAny(['track']) || incoming().track in ['teen', 'juvenil', 'youngAdult', 'adult'])
        && incoming().notes is map
        && incoming().updatedAt == request.time;
      allow delete: if isAuthenticated() && docId.split('_')[0] == request.auth.uid;
    }

    function isValidOverride(data) {
      return (!data.keys().hasAny(['titulo']) || data.titulo is string)
        && (!data.keys().hasAny(['conteudo']) || data.conteudo is string)
        && (!data.keys().hasAny(['versiculoChave']) || (data.versiculoChave is map && data.versiculoChave.keys().hasAll(['texto','referencia'])))
        && (!data.keys().hasAny(['perguntas']) || data.perguntas is list)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time);
    }

    match /conteudoOverrides/{docId} {
      allow get, list: if isAuthenticated();
      allow create, update: if canManage() && isValidOverride(incoming());
      allow delete: if isUserAdmin();
    }

    // ===== Jogo ao Vivo (estilo Kahoot) =====
    // Sala pública (liveGames) + gabarito privado (liveGamesPrivate) — mesma
    // separação de pairs/pairsPublic, só invertida: aqui o doc PRIVADO é que
    // fica de fora do que todo jogador assina, para ninguém ler `correta` pela
    // aba Network antes do host revelar. Jogadores (inclusive convidados
    // anônimos) só precisam de isAuthenticated(); nunca de canManage().
    //
    // Este bloco NASCEU idêntico ao publicado no LUM07 (mesmo projeto/banco
    // Firestore compartilhado — ver .firebaserc/.env), mas divergiu de
    // propósito: streak/pausa/tipos de pergunta/liveFeedback/etc. só existem
    // aqui. Um deploy do LUM07 sobrescreve este bloco com a versão dele (sem
    // esses campos) até que ele seja atualizado para incluí-los — por isso
    // toda escrita de campo NOVO introduzido depois da divergência (streak/
    // maxStreak, pausado/msPausados/duracaoAtualSec, tipo/multiplicador em
    // currentQuestion) tenta gravar completo e refaz sem o campo se a regra
    // recusar (ver o try/catch em entrarNaSala/iniciarPergunta/
    // avancarParaPlacar/revelarPergunta/encerrarJogo em liveGameApi.ts) —
    // assim a partida nunca trava, só perde o recurso até as regras
    // republicarem.
    function isGameHost(code) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/liveGames/$(code))
        && get(/databases/$(database)/documents/liveGames/$(code)).data.hostId == request.auth.uid;
    }

    // `currentQuestion` é o único jeito de uma pergunta chegar a quem ainda não
    // acertou/errou — por isso, mesmo confiando no host, a regra também recusa
    // se ele vier com 'correta'/'explicacao' dentro (defesa em profundidade;
    // firebase.ts já monta esse campo sanitizado antes de escrever).
    // ATENÇÃO — este bloco é publicado no MESMO banco que o LUM07 usa. O campo
    // 'placar' é uma adição do App-Adole-: enquanto o LUM07 não tiver esta
    // mesma lista, um deploy de lá remove o campo daqui e as escritas com
    // placar passam a ser recusadas. O cliente trata isso (avancarParaPlacar
    // reescreve sem o campo e o aluno volta a assinar livePlayers), então a
    // partida não trava — só volta a custar mais leitura.
    function isValidLiveGame(data) {
      return data.keys().hasOnly(['code', 'hostId', 'hostName', 'track', 'semana', 'trimestre', 'licaoTitulo', 'totalQuestions', 'questionDurationSec', 'phase', 'currentIndex', 'currentQuestion', 'questionStartedAt', 'revealCorrectIndex', 'revealExplicacao', 'revealCounts', 'faseIniciadaEm', 'placar', 'createdAt', 'endedAt', 'pausado', 'msPausados', 'soNoTelao', 'duracaoAtualSec', 'rodada'])
        && (!data.keys().hasAny(['placar']) || (data.placar is list && data.placar.size() <= 300))
        && data.code is string && data.code.size() > 0 && data.code.size() <= 12
        && data.hostId is string
        && data.hostName is string && data.hostName.size() <= 50
        && data.track in ['teen', 'juvenil', 'youngAdult', 'adult']
        && data.semana is string
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 50
        && data.questionDurationSec is number && data.questionDurationSec > 0
        // 'reveal' = gráfico de quantos marcaram cada opção; 'placar' = ranking
        // entre uma pergunta e outra. As duas são passagens automáticas.
        && data.phase in ['lobby', 'question', 'reveal', 'placar', 'ended']
        && data.currentIndex is number
        // Pausa: o host congela o cronômetro. `msPausados` acumula quanto tempo
        // a pergunta ficou parada, e todo prazo (contagem, cronômetro, avanço
        // automático) soma isso — assim host e celulares voltam sincronizados.
        && (!data.keys().hasAny(['pausado']) || data.pausado is bool)
        && (!data.keys().hasAny(['msPausados']) || (data.msPausados is number && data.msPausados >= 0))
        // Modo "só no telão": a pergunta e o texto das opções NÃO vão para o
        // celular (só os símbolos coloridos), obrigando a turma a olhar para
        // a projeção — é o comportamento clássico do Kahoot em sala.
        && (!data.keys().hasAny(['soNoTelao']) || data.soNoTelao is bool)
        // Duração desta pergunta: `questionDurationSec` é imutável (padrão da
        // sala); esta sobrepõe por pergunta sem quebrar aquela trava.
        && (!data.keys().hasAny(['duracaoAtualSec']) || (data.duracaoAtualSec is number && data.duracaoAtualSec > 0 && data.duracaoAtualSec <= 300))
        // Revanche: incrementa a cada "jogar de novo" na MESMA sala. Os
        // clientes usam para zerar estado local sem precisar de sala nova.
        && (!data.keys().hasAny(['rodada']) || (data.rodada is number && data.rodada >= 0))
        && (!data.keys().hasAny(['revealCounts']) || data.revealCounts == null || data.revealCounts is list)
        // `tipo`: 'quiz' (múltipla escolha), 'vf' (verdadeiro/falso) ou
        // 'enquete' (sem resposta certa, não pontua).
        // `multiplicador`: 0 = não vale ponto, 1 = normal, 2 = pontos em dobro.
        && (!data.keys().hasAny(['currentQuestion']) || data.currentQuestion == null || (data.currentQuestion is map
              && data.currentQuestion.keys().hasOnly(['pergunta', 'opcoes', 'tipo', 'multiplicador'])
              && (!data.currentQuestion.keys().hasAny(['tipo']) || data.currentQuestion.tipo in ['quiz', 'vf', 'enquete'])
              && (!data.currentQuestion.keys().hasAny(['multiplicador']) || (data.currentQuestion.multiplicador is number && data.currentQuestion.multiplicador >= 0 && data.currentQuestion.multiplicador <= 2))));
    }

    match /liveGames/{code} {
      // Sala é lida por qualquer autenticado (inclusive convidado anônimo que
      // acabou de escanear o QR) — o conteúdo já vem sanitizado.
      allow get, list: if isAuthenticated();

      allow create: if canManage()
        && code == incoming().code
        && incoming().hostId == request.auth.uid
        && incoming().phase == 'lobby'
        && incoming().currentIndex == -1
        && incoming().createdAt == request.time
        && isValidLiveGame(incoming());

      // Só o próprio host controla a sala; code/hostId/track/semana/duração são imutáveis.
      allow update: if isAuthenticated()
        && existing().hostId == request.auth.uid
        && incoming().hostId == existing().hostId
        && incoming().code == existing().code
        && incoming().track == existing().track
        && incoming().semana == existing().semana
        && incoming().questionDurationSec == existing().questionDurationSec
        && incoming().createdAt == existing().createdAt
        && isValidLiveGame(incoming());

      allow delete: if isUserAdmin() || (isAuthenticated() && existing().hostId == request.auth.uid);
    }

    function isValidLiveGamePrivate(data) {
      return data.keys().hasOnly(['perguntas']) && data.perguntas is list;
    }

    match /liveGamesPrivate/{code} {
      // Só o host lê o gabarito completo (ex.: recuperar após um F5 no meio do jogo).
      allow get: if isGameHost(code);
      // canManage() já restringe a professor/admin; não dá para exigir
      // isGameHost(code) aqui porque este doc nasce no MESMO writeBatch que
      // liveGames/{code} — get()/exists() dentro de um batch veem o banco como
      // estava ANTES do batch, então liveGames/{code} ainda "não existiria".
      allow create: if canManage() && isValidLiveGamePrivate(incoming());
      allow update, delete: if false;
    }

    function isValidLivePlayer(data) {
      return data.keys().hasOnly(['code', 'uid', 'nome', 'avatar', 'isGuest', 'score', 'joinedAt', 'streak', 'maxStreak'])
        && data.code is string
        && data.uid is string
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 50
        && data.avatar is string && data.avatar.size() <= 1048576
        && (!data.keys().hasAny(['isGuest']) || data.isGuest is bool)
        // Sequência de acertos seguidos (o "answer streak" do Kahoot). Zera ao
        // errar OU ao não responder — quem some do jogo perde a sequência.
        && (!data.keys().hasAny(['streak']) || (data.streak is number && data.streak >= 0))
        && (!data.keys().hasAny(['maxStreak']) || (data.maxStreak is number && data.maxStreak >= 0))
        && data.score is number;
    }

    match /livePlayers/{docId} {
      // Regra não filtra a query — o host assina livePlayers do jogo dele para
      // montar o lobby/placar; conteúdo é mínimo (nome/avatar/pontuação efêmera).
      allow get, list: if isAuthenticated();

      allow create: if isAuthenticated()
        && docId == incoming().code + '_' + request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().score == 0
        && incoming().joinedAt == request.time
        && isValidLivePlayer(incoming());

      // Só o host credita pontos e mexe na sequência (depois de conferir a
      // resposta no gabarito privado). É por aqui também que a revanche zera
      // todo mundo sem recriar os documentos — o jogador nunca se auto-pontua.
      allow update: if isGameHost(existing().code)
        && incoming().diff(existing()).affectedKeys().hasOnly(['score', 'streak', 'maxStreak'])
        && isValidLivePlayer(incoming());

      allow delete: if isUserAdmin() || isGameHost(existing().code);
    }

    function isValidLiveAnswer(data) {
      return data.keys().hasOnly(['code', 'uid', 'idx', 'opcaoEscolhida', 'answeredAt', 'tempoRespostaMs', 'graded', 'correta', 'pontos', 'bonusStreak', 'streakDepois'])
        && data.code is string
        && data.uid is string
        && data.idx is number
        && data.opcaoEscolhida is number
        && data.tempoRespostaMs is number
        && data.graded is bool
        && (!data.keys().hasAny(['correta']) || data.correta is bool)
        // Guardados separados de `pontos` para a tela do aluno mostrar a conta
        // ("+850 e +200 de sequência") em vez de um número só sem explicação.
        && (!data.keys().hasAny(['bonusStreak']) || data.bonusStreak is number)
        && (!data.keys().hasAny(['streakDepois']) || data.streakDepois is number)
        && (!data.keys().hasAny(['pontos']) || data.pontos is number);
    }

    match /liveAnswers/{docId} {
      // Só o próprio dono e o host leem uma resposta — antes disso, qualquer
      // autenticado conseguia listar liveAnswers da pergunta corrente e ver o
      // que os colegas marcaram antes de responder. `assinarMinhaResposta`
      // (o jogador) sempre lê o PRÓPRIO doc; `buscarRespostasPergunta` (o
      // host, para corrigir) é a única lista de verdade.
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isGameHost(resource.data.code));
      allow list: if isGameHost(resource.data.code);

      // Só responde a pergunta CORRENTE da sala (phase='question', mesmo índice)
      // — impede responder perguntas futuras cujo texto já tenha chegado por
      // algum motivo, e impede reescrever resposta de pergunta já encerrada.
      allow create: if isAuthenticated()
        && docId == incoming().code + '_' + request.auth.uid + '_' + string(incoming().idx)
        && incoming().uid == request.auth.uid
        && incoming().graded == false
        && incoming().answeredAt == request.time
        && get(/databases/$(database)/documents/liveGames/$(incoming().code)).data.phase == 'question'
        && get(/databases/$(database)/documents/liveGames/$(incoming().code)).data.currentIndex == incoming().idx
        && isValidLiveAnswer(incoming());

      // Só o host corrige (é o único com acesso ao gabarito em liveGamesPrivate).
      allow update: if isGameHost(existing().code)
        && incoming().diff(existing()).affectedKeys().hasOnly(['graded', 'correta', 'pontos', 'bonusStreak', 'streakDepois'])
        && incoming().graded == true
        && isValidLiveAnswer(incoming());

      allow delete: if isUserAdmin() || isGameHost(existing().code);
    }

    // ===== Feedback do aluno no fim da partida =====
    // Coleção própria (e não um campo em livePlayers) porque ali só o host
    // escreve — aqui é o contrário: cada aluno escreve o SEU e ninguém lê o
    // dos outros. Doc id composto impede responder duas vezes.
    function isValidLiveFeedback(data) {
      return data.keys().hasOnly(['code', 'uid', 'estrelas', 'aprendeu', 'criadoEm'])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 12
        && data.uid is string
        && data.estrelas is number && data.estrelas >= 1 && data.estrelas <= 5
        && (!data.keys().hasAny(['aprendeu']) || data.aprendeu is bool)
        && data.criadoEm == request.time;
    }

    match /liveFeedback/{docId} {
      // Só quem gerencia lê — é devolutiva para o professor, não placar.
      allow get, list: if canManage();
      allow create: if isAuthenticated()
        && docId == incoming().code + '_' + request.auth.uid
        && incoming().uid == request.auth.uid
        && isValidLiveFeedback(incoming());
      // Imutável: a primeira resposta é a resposta.
      allow update: if false;
      allow delete: if isUserAdmin() || isGameHost(existing().code);
    }

    // ===== Log de erro (automático) e relatos de usuário (manuais) =====
    // Nenhum dos dois pode ser lido/alterado por outro aluno: são caixa de
    // entrada da liderança, não conteúdo do app. Campos opcionais aceitam
    // null porque quem loga pode ainda não ter perfil carregado (erro logo
    // no boot, antes de `jogador` existir).
    function camposDiagnosticoValidos(data) {
      return (!data.keys().hasAny(['userId']) || data.userId == null || data.userId is string)
        && (!data.keys().hasAny(['nome']) || data.nome == null || data.nome is string)
        && (!data.keys().hasAny(['email']) || data.email == null || data.email is string)
        && (!data.keys().hasAny(['tela']) || data.tela == null || data.tela is string)
        && data.buildId is string
        && data.userAgent is string && data.userAgent.size() <= 500
        && data.criadoEm == request.time;
    }

    function isValidErrorLog(data) {
      return data.keys().hasAll(['origem', 'mensagem', 'buildId', 'userAgent', 'criadoEm'])
        && data.keys().hasOnly(['userId', 'nome', 'email', 'tela', 'origem', 'mensagem', 'detalhe', 'url', 'buildId', 'userAgent', 'criadoEm'])
        && data.origem in ['boundary', 'window', 'promise']
        && data.mensagem is string && data.mensagem.size() <= 2000
        && (!data.keys().hasAny(['detalhe']) || (data.detalhe is string && data.detalhe.size() <= 4000))
        && (!data.keys().hasAny(['url']) || (data.url is string && data.url.size() <= 500))
        && camposDiagnosticoValidos(data);
    }

    match /errorLogs/{id} {
      // Só quem gerencia lê — é diagnóstico técnico, não dado de aluno comum.
      allow get, list: if canManage();
      allow create: if isAuthenticated() && isValidErrorLog(incoming());
      allow update: if false;
      allow delete: if isUserAdmin();
    }

    function isValidUserReport(data) {
      return data.keys().hasAll(['mensagem', 'status', 'buildId', 'userAgent', 'criadoEm'])
        && data.keys().hasOnly(['userId', 'nome', 'email', 'tela', 'mensagem', 'ultimoErro', 'status', 'buildId', 'userAgent', 'criadoEm'])
        && data.mensagem is string && data.mensagem.size() > 0 && data.mensagem.size() <= 1000
        && data.status == 'novo'
        && (!data.keys().hasAny(['ultimoErro']) || (data.ultimoErro is string && data.ultimoErro.size() <= 2000))
        && camposDiagnosticoValidos(data);
    }

    match /userReports/{id} {
      allow get, list: if canManage();
      allow create: if isAuthenticated() && isValidUserReport(incoming());
      // Só a liderança move o status (lido/resolvido); o resto do relato é imutável.
      allow update: if canManage()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().status in ['novo', 'lido', 'resolvido'];
      allow delete: if isUserAdmin();
    }

  }
}
